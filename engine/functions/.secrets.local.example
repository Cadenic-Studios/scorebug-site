# Scorebug engine — secrets. Copy to functions/.secrets.local (gitignored) and
# fill what you have. Leave a line blank or delete it for a capability you do
# not have yet: ignite.mjs stores a sentinel so the deploy proceeds, and the
# digest names what is off. One KEY=value per line, no quotes.
#
# ── Networks ─────────────────────────────────────────────────────────────
# Bluesky: log in with the DID, never the handle (handles change). This is the
# DID of the account created 2026-09-09 (@scorebug-app.bsky.social until the
# domain handle verifies); it is public, and it is what the site serves at
# /.well-known/atproto-did.
BSKY_HANDLE=did:plc:j6ypvmvjbaya4mbwxrrrci24
BSKY_APP_PASSWORD=
# What the profile shows: the domain handle once "Verify Text File" passes,
# scorebug-app.bsky.social until then.
BSKY_DISPLAY_HANDLE=getscorebug.app

# Mastodon: @scorebug@mastodon.social. Preferences → Development → New application → read write.
MASTODON_BASE=https://mastodon.social
MASTODON_TOKEN=

# Threads: the numeric user id and a long-lived token from the Meta app (Threads API product).
THREADS_USER_ID=
THREADS_TOKEN=

# Instagram (same Meta app, Instagram API with Instagram Login product). Month two.
IG_USER_ID=
IG_TOKEN=

# X: @scorebug_app. Pay-per-use developer account; set a US$15 spending limit in X's console first.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_HANDLE=scorebug_app

# ── Services ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_SECRET=
# What you will type into getscorebug.app/ops. Any string; goes to Vercel only.
OPS_CONSOLE_PASSWORD=
# 32 hex characters, also set as the site's INDEXNOW_KEY
INDEXNOW_KEY=
# 64 hex characters, also set as the site's DISPATCH_KEY (facts endpoint + card press)
DISPATCH_KEY=
SITE_BASE_URL=https://getscorebug.app
DISCORD_WEBHOOK_URL=
# ── The Discord bot ──────────────────────────────────────────────────────
# All three are on the Discord application page. Only the PUBLIC KEY reaches
# the website: it verifies that an interaction really came from Discord and
# can do nothing else. The BOT TOKEN never leaves this file — it can act as
# the bot, and the only thing that needs it is the one-time command
# registration script.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# The engine project's WEB API key (Firebase console → Project settings → Web API key).
# Not a secret — it authorises nothing — but the site needs it to read the weekly slate.
ENGINE_WEB_API_KEY=

# ── Google ───────────────────────────────────────────────────────────────
# A PATH to the downloaded service-account JSON; the file's contents are sent.
GOOGLE_SERVICE_ACCOUNT=./scorebug-engine-sa.json
GA4_PROPERTY_ID=properties/551128063
# Only once there is a public Play listing:
PLAY_BUCKET=
PLAY_PACKAGE=ca.scorebug.sports

# ── The product's database (read-only aggregates; see database-v54.sql) ──
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_ANON_KEY=
# 64 hex characters, ALSO stored in Supabase private.app_secrets as 'engine_key'
ENGINE_KEY=

# ── FILLED 2026-09-10 ────────────────────────────────────────────────────
# MASTODON_TOKEN, X_API_KEY and X_API_SECRET were transcribed from
# screenshots. If a network reports "not live" after ignite, suspect a
# mis-read character before anything else and paste that one value again.
#
# X_ACCESS_TOKEN / X_ACCESS_SECRET are deliberately still blank. They must be
# generated AFTER the app's permission is saved as Read and Write, or X issues
# a read-only pair that fails only at the moment of the first post.
# X's Bearer Token is not used: the engine posts with OAuth 1.0a user context,
# which needs the four values above and never a bearer.

# ── Cadenic outreach ─────────────────────────────────────────────────────
# The mailing address CASL requires on every commercial email. The beat drafts
# without it and refuses to send. A real street address, not a PO box you do
# not check.
CADENIC_POSTAL=
# The From line. Must be on a domain Resend has verified (cadenic.studio is).
CADENIC_FROM=Wyatt at Cadenic Studios <hello@cadenic.studio>
